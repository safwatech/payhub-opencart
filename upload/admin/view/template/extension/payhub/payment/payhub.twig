{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <h1>PayHub</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        <div class="card">
            <div class="card-header"><i class="fas fa-pencil-alt"></i> Edit PayHub</div>
            <div class="card-body">
                <form id="form-payhub" action="{{ action }}" method="post" enctype="multipart/form-data" class="form-horizontal">
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Status</label>
                        <div class="col-sm-10">
                            <select name="payment_payhub_status" class="form-select">
                                <option value="1"{% if payment_payhub_status %} selected{% endif %}>Enabled</option>
                                <option value="0"{% if not payment_payhub_status %} selected{% endif %}>Disabled</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Environment</label>
                        <div class="col-sm-10">
                            <select name="payment_payhub_environment" class="form-select">
                                <option value="production"{% if payment_payhub_environment == 'production' %} selected{% endif %}>Production</option>
                                <option value="sandbox"{% if payment_payhub_environment == 'sandbox' %} selected{% endif %}>Sandbox</option>
                                <option value="custom"{% if payment_payhub_environment == 'custom' %} selected{% endif %}>Custom</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Base URL</label>
                        <div class="col-sm-10">
                            <input type="text" name="payment_payhub_base_url" value="{{ payment_payhub_base_url }}" placeholder="https://app.payhub.ly" class="form-control" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">API key</label>
                        <div class="col-sm-10">
                            <input type="password" name="payment_payhub_api_key" value="{{ payment_payhub_api_key }}" placeholder="phk_…" class="form-control" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Webhook secret (hex)</label>
                        <div class="col-sm-10">
                            <input type="password" name="payment_payhub_webhook_secret_hex" value="{{ payment_payhub_webhook_secret_hex }}" class="form-control" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Default PSP</label>
                        <div class="col-sm-10">
                            <select name="payment_payhub_default_psp" class="form-select">
                                {% for v, l in {'sadad':'Sadad','moamalat':'Moamalat','mobicash':'Mobicash','tlync':'T-Lync','adfali':'Adfali'} %}
                                <option value="{{ v }}"{% if payment_payhub_default_psp == v %} selected{% endif %}>{{ l }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Debug log</label>
                        <div class="col-sm-10">
                            <select name="payment_payhub_debug" class="form-select">
                                <option value="0"{% if not payment_payhub_debug %} selected{% endif %}>Off</option>
                                <option value="1"{% if payment_payhub_debug %} selected{% endif %}>On</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Sort order</label>
                        <div class="col-sm-10">
                            <input type="text" name="payment_payhub_sort_order" value="{{ payment_payhub_sort_order }}" class="form-control" />
                        </div>
                    </div>
                    <div class="text-end">
                        <a href="{{ cancel }}" class="btn btn-default">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{{ footer }}
